# Salin berkas ini jadi `.env`, lalu isi setiap nilai.
# Panduan lengkap cara mendapatkan tiap nilai: docs/setup.md

# --- Postgres ---
# Dipakai docker-compose untuk membuat DB dan menyusun DATABASE_URL.
POSTGRES_PASSWORD=change_me

# Hanya dipakai saat `npm run dev` di host tanpa Docker.
# Di bawah Docker Compose nilai ini DIABAIKAN: docker-compose.yml menimpanya
# lewat blok `environment` supaya host-nya menunjuk service `iconform-db`.
DATABASE_URL=postgresql://iconform:change_me@localhost:5432/iconform

# --- Sesi ---
# openssl rand -base64 32
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# --- Admin yang di-seed ---
# Seed dijalankan ulang setiap container boot: password admin selalu
# dikembalikan ke nilai di sini. WAJIB minimal 12 karakter, kalau kurang seed
# gagal dan server tidak pernah start (prisma/seed.ts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_ini
ADMIN_NAME=Administrator PDL FORM

# --- Google Drive OAuth ---
# Akun pengguna, bukan service account: service account tidak punya kuota
# penyimpanan di akun Google non-Workspace.
# Cara ambil refresh token: node scripts/get-refresh-token.mjs <oauth-client.json>
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# --- Folder Drive tujuan arsip ---
# ID diambil dari URL folder: drive.google.com/drive/folders/<ID>
# Dua yang di bawah ini penampung per jenis folder; cukup isi keduanya kalau
# tidak mau memisah per jenis surat.
GDRIVE_FOLDER_SURAT_TUGAS_ID=
GDRIVE_FOLDER_BERITA_ACARA_ID=
# Folder per jenis Berita Acara. Kalau diisi, menang atas penampung di atas.
# Catatan: BAI dan UID_JABAR sengaja memakai satu folder yang sama.
GDRIVE_FOLDER_BAI_ID=
GDRIVE_FOLDER_BAKL_ID=
GDRIVE_FOLDER_BAP_ID=
GDRIVE_FOLDER_BA_PENGUJIAN_ID=
GDRIVE_FOLDER_BAST_ID=

# --- Spreadsheet daftar nomor surat (opsional) ---
# ID dari URL: docs.google.com/spreadsheets/d/<ID>/edit
# Daftar nomor harus di kolom A tab PERTAMA. Kalau kosong, autocomplete nomor
# mati tanpa pesan error.
GDRIVE_SHEET_NOMOR_ID=
