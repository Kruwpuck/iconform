POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://iconform:change_me@localhost:5432/iconform

AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# seeded admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator ICONFORM

# feature flag — email auth UI hidden while false
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=false

# Google Drive OAuth (user account — service accounts have no quota on free plans)
# Get refresh token: node scripts/get-refresh-token.mjs <oauth-client.json>
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
GDRIVE_FOLDER_SURAT_TUGAS_ID=
GDRIVE_FOLDER_BERITA_ACARA_ID=
# per-jenis BA folders (dokumen masuk sesuai kriterianya)
GDRIVE_FOLDER_BAI_ID=
GDRIVE_FOLDER_BAKL_ID=
GDRIVE_FOLDER_BAP_ID=
GDRIVE_FOLDER_BA_PENGUJIAN_ID=
